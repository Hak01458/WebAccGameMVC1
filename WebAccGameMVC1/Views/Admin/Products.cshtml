@using WebAccGameMVC.Models
@model IEnumerable<Product>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý bánh";
    var stt = 0;
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<div class="card shadow-sm border-0 mb-3">
    <div class="card-header bg-white">
        <h6 class="mb-0">Thêm bánh</h6>
    </div>
    <div class="card-body">
        <form asp-action="CreateProduct" asp-controller="Admin" method="post" enctype="multipart/form-data" class="row g-2">
            @Html.AntiForgeryToken()
            <div class="col-12 col-md-3">
                <input name="productName" class="form-control" placeholder="Tên bánh" required />
            </div>
            <div class="col-12 col-md-2">
                <input type="number" name="price" class="form-control" min="0" step="1000" placeholder="Giá" required />
            </div>
            <div class="col-12 col-md-2">
                <select name="categoryId" class="form-select" required>
                    <option value="">Danh mục</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.CategoryId">@c.CategoryName</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-primary w-100">Thêm bánh</button>
            </div>
            <div class="col-12">
                <input name="description" class="form-control" placeholder="Mô tả (tuỳ chọn)" />
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Danh sách bánh</h5>
        <span class="badge text-bg-secondary">@Model.Count()</span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width:70px;">STT</th>
                        <th style="width:80px;">Ảnh</th>
                        <th>Tên bánh</th>
                        <th style="width:160px;">Danh mục</th>
                        <th style="width:140px;">Giá</th>
                        <th style="width:220px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        stt++;
                        <tr>
                            <td>@stt</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Image))
                                {
                                    <img src="@item.Image" style="width:48px;height:48px;object-fit:cover;" class="rounded border" />
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@item.ProductName</div>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <small class="text-muted">@item.Description</small>
                                }
                            </td>
                            <td>@(item.Category?.CategoryName ?? "-")</td>
                            <td>@item.Price.ToString("N0") đ</td>
                            <td class="d-flex gap-1">
                                <a asp-controller="Admin" asp-action="EditProduct" asp-route-productId="@item.ProductId"
                                   class="btn btn-sm btn-outline-secondary">
                                    Chỉnh sửa
                                </a>

                                <form asp-action="DeleteProduct" asp-controller="Admin" method="post"
                                      onsubmit="return confirm('Bạn có chắc muốn xóa bánh này?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-muted">Chưa có bánh nào.</div>
        }
    </div>
</div>
